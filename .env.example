# ==============================================
# CONFIGURATION ENVIRONNEMENT - SABRINA PWA
# ==============================================
# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs
# NE JAMAIS committer .env.local !

# ----------------------------------------------
# SUPABASE (Base de données et Auth)
# ----------------------------------------------
# Dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://votre-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (CRITIQUE - Ne JAMAIS exposer côté client)
# Utilisé uniquement dans scripts/setup-admin-users.ts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mots de passe admin (utilisés uniquement par scripts/setup-admin-users.ts)
ADMIN_SABRINA_PASSWORD=mot_de_passe_fort_ici
ADMIN_JOHAN_PASSWORD=mot_de_passe_fort_ici

# ----------------------------------------------
# POSTGRESQL (via Supabase)
# ----------------------------------------------
# Port 6543 = Connection pooling (pour Prisma dans serverless)
DATABASE_URL=postgresql://postgres.xxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Port 5432 = Connexion directe (pour les migrations)
DIRECT_URL=postgresql://postgres.xxx:MOT_DE_PASSE@db.xxx.supabase.co:5432/postgres

# ----------------------------------------------
# RESEND (Emails)
# ----------------------------------------------
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------
# STRIPE (Paiements)
# ----------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys

# Clé publique (peut être exposée côté client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète (NE JAMAIS exposer côté client)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret (pour vérifier les événements Stripe)
# Obtenu après création du webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------
# APPLICATION
# ----------------------------------------------
# URL publique de l'application
# Développement
NEXT_PUBLIC_URL=http://localhost:3000

# Production (à changer lors du déploiement)
# NEXT_PUBLIC_URL=https://sabrina-wellness.com

# ----------------------------------------------
# OPTIONNEL
# ----------------------------------------------
# Mode debug
# NODE_ENV=development
